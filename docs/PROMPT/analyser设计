表1：run（一次运行）
CREATE TABLE runs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
    pcap_name TEXT,
    rule_count INTEGER,
    runtime REAL,
    pkt_per_sec REAL,
    mbps REAL,
    cpu_user REAL,
    cpu_sys REAL,
    memory_kb INTEGER
);
表2：metrics（Snort内部指标）
CREATE TABLE metrics (
    run_id INTEGER,
    hard_evals INTEGER,
    pkt_searches INTEGER,
    pdu_searches INTEGER,
    alerts INTEGER,
    pcre_match_limit INTEGER,
    match_limit INTEGER,
    alert_limit INTEGER,
    tcp_sessions INTEGER,
    udp_sessions INTEGER,
    flows INTEGER,
    rebuilt_packets INTEGER,
    FOREIGN KEY(run_id) REFERENCES runs(id)
);
表3：检测效果（你已有）
CREATE TABLE detection (
    run_id INTEGER,
    alerted_flows INTEGER,
    false_positive_flows INTEGER,
    missed_flows INTEGER,
    fpr REAL,
    miss_rate REAL,
    FOREIGN KEY(run_id) REFERENCES runs(id)
);